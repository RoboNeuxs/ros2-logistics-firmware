{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "STM32: 编译生成 HEX / BIN",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/Scripts/build_keil.ps1",
                "-Rebuild"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "STM32: 校验 HEX / BIN",
            "type": "process",
            "command": "python",
            "args": ["${workspaceFolder}/Scripts/verify_image.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
